# Shared scons flags for the physx build. Sourced by container-build.sh (bash syntax).

# Flags every target uses.
COMMON_FLAGS='module_mono_enabled=yes arch=x86_64 disable_3d_physics=yes disable_modules=webp,theora,mobile_vr'

# Extra flags per platform.
LINUX_FLAGS='platform=linuxbsd'
# use_static_cpp avoids needing libstdc++/libgcc DLLs next to the exe.
WINDOWS_FLAGS='platform=windows use_mingw=yes use_static_cpp=yes d3d12=yes'

# Profiles, selected with `build.sh --profile`.
PROFILE_DEV_FLAGS=''
# lto=thin is memory hungry. Raise WSL swap (see README) or use lto=none.
PROFILE_PRODUCTION_FLAGS='production=yes lto=thin'

# Build cache (mounted from a Docker volume). Size limit is in MB.
export SCONS_CACHE=/cache/scons
export SCONS_CACHE_LIMIT=${SCONS_CACHE_LIMIT:-12288}
